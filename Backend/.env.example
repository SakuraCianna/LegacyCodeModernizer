# 后端服务运行端口, 默认 4000
PORT=4000

# 后端服务主机监听地址, 默认 0.0.0.0
HOST=0.0.0.0

# 前端工作台访问地址, 用于 OAuth 回调与跨域放行
FRONTEND_URL=http://localhost:5173

# GitHub OAuth 客户端 ID, 用于开发者单点登录
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth 客户端密钥, 用于换取用户访问凭证
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT 鉴权会话密钥, 用于生成用户登录令牌
JWT_SECRET=your_super_secret_jwt_key_here

# 可选服务端全局兜底 DeepSeek API 密钥, 系统默认采用前端用户自带密钥 (BYOK 模式)
DEEPSEEK_API_KEY=

# 可选服务端全局兜底 DeepSeek API 基础地址, 默认官方原生端点
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
